<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/textTitleSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="24dp" />

        <TextView
            android:id="@+id/textMyAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My account"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingVertical="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/textAddAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add account"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingVertical="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/textChangePassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Change password"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingVertical="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/textChangeLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Change language"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingVertical="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/textUpgradePlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upgrade plan"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingVertical="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/textMultipleAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Multiple account"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingVertical="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground" />


        <!-- Un peu d'espace avant les switches -->
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <!-- Enable sync -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/textEnableSync"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Enable sync"
                android:textSize="16sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchEnableSync"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Enable 2 step verification -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/textEnable2Step"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Enable 2 step verification"
                android:textSize="16sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchEnable2Step"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
